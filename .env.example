# Runtime baseline from the engineering plan; reasoning effort is medium.
OPENAI_API_KEY=your_openai_api_key_here

# Optional local service configuration. Keep Luna for high-volume triage only.
ASQ_ROUTER_MODEL=gpt-5.6-sol
# Full-stack authority. Ctrl+Shift+B starts this loopback service before workers.
CONTROL_PLANE_PORT=4100
CONTROL_PLANE_URL=http://127.0.0.1:4100
# Required for manual service startup. Ctrl+Shift+B generates an ephemeral
# 256-bit token and gives it only to Control Plane and Command Center.
GSS_CONTROL_PLANE_TOKEN=
# Rates are model/provider-specific. Leave blank when unknown, never use zero
# as a substitute for missing pricing. Cached reads/writes require their own rates.
ASQ_MODEL_INPUT_COST_MICROS_PER_1K=
ASQ_MODEL_OUTPUT_COST_MICROS_PER_1K=
ASQ_MODEL_CACHED_COST_MICROS_PER_1K=
ASQ_MODEL_CACHE_WRITE_COST_MICROS_PER_1K=
GSS_ENFORCE_COST_ACCOUNTING=false

# Hard input budget before untrusted logs/prompts are sent to the LLM.
# The router quarantines prompt-injection text, redacts detected secrets, and
# preserves selected indicators plus a provenance hash outside the model input.
ASQ_CONTEXT_MAX_TOKENS=4096

# Local-only authentication for launch modes other than Ctrl+Shift+B.
# Ctrl+Shift+B injects the loopback-only preview account BaoNVG / 1 and marks
# it explicitly as insecure demo auth. Never enable that mode in deployment.
# Generate a cryptographically random signing secret with at least 32 characters.
ASQ_JWT_SECRET=
ASQ_ADMIN_USERNAME=
# At least 16 characters. Production login is intentionally disabled.
ASQ_ADMIN_PASSWORD=
ASQ_INSECURE_LOCAL_DEMO_AUTH=false
ASQ_WEB_ORIGIN=http://localhost:3000
ASQ_WS_URL=ws://127.0.0.1:4000
# Generate signed, one-hour credentials with scripts/create-agent-token.ts.
ASQ_WORKER_TOKEN=
ASQ_IDE_TOKEN=

# PostgreSQL is the only supported durable state store. Ctrl+Shift+B fails
# closed when this value is absent and applies verified migrations before start.
DATABASE_URL=postgresql://asq_user:asq_password@127.0.0.1:5432/asq_db
DATABASE_SSL=false
GSS_DATA_DIR=./data
# Ed25519 PKCS#8 private key encoded as base64. The one-button launcher strips
# this value from Command Center, workers and UI; only Control Plane receives it.
GSS_ARTIFACT_SIGNING_PRIVATE_KEY_BASE64=
GSS_ARTIFACT_SIGNING_KEY_ID=
# Keep false only for local development. Staging must set true and configure
# both signing variables above, otherwise Control Plane startup fails closed.
GSS_REQUIRE_ARTIFACT_SIGNATURE=false
# Sandbox is fail-closed by default. Enable only on a staging host with Docker.
GSS_SANDBOX_MODE=blocked
GSS_SANDBOX_IMAGE=
GSS_SANDBOX_REPOSITORY_ROOT=
# Explicit real paths separated by ';'. Rootless Linux, digest-pinned image required.
GSS_SANDBOX_ALLOWED_ROOTS=
GSS_SANDBOX_REQUIRE_GVISOR=false

# IDE worker read-only repository roots. Separate multiple roots with ';' on
# Windows or ':' on Linux/macOS. Ctrl+Shift+B defaults this to the repo root.
GSS_IDE_REPOSITORY_ROOTS=.
GSS_IDE_MAX_FILES=250
GSS_IDE_MAX_FILE_BYTES=262144
GSS_IDE_MAX_TOTAL_BYTES=2097152
GSS_IDE_MAX_MATCHES=100
GSS_IDE_MAX_OUTPUT_BYTES=49152
GSS_IDE_MAX_TIMEOUT_MS=15000

# Google Chronicle / Google SecOps read-only UDM Search. Authentication uses
# Application Default Credentials or Workload Identity; API keys are rejected.
GSS_CHRONICLE_PROJECT=
GSS_CHRONICLE_LOCATION=
GSS_CHRONICLE_INSTANCE=
GSS_CHRONICLE_ENDPOINT=https://us-chronicle.googleapis.com

# Staging API identity: viewer data access is separate from operator identity.
GSS_RUNTIME_ENV=local
# Control Plane policy only. Empty = unbudgeted local demo; staging refuses empty.
# Supply reviewed per-provider/model ceilings, NOT heuristic token counts or guessed prices.
# Example fixture (not pricing advice): {"version":"fixture-only","caseBudgetMicros":200,"models":[{"provider":"openai","model":"gpt-5.6-sol","reservationMicros":80,"maxRequestBytes":32768,"maxOutputTokens":1200}]}
GSS_MODEL_BUDGET_POLICY_JSON=
GSS_OIDC_ISSUER=
GSS_OIDC_AUDIENCE=
GSS_OIDC_JWKS_URI=
# OIDC browser login is not yet connected; staging UI fails closed.

# Manual startup: CP owns private task key; workers hold only public key.
# Ctrl+Shift+B generates an ephemeral local task pair, not staging PKI.
GSS_TASK_KEY_ID=
GSS_TASK_PRIVATE_KEY_BASE64=
GSS_TASK_PUBLIC_KEY_BASE64=
GSS_UI_GATEWAY_TOKEN=

# S3 staging requires Object Lock enabled on the bucket; no filesystem fallback.
GSS_ARTIFACT_STORE=filesystem
GSS_S3_BUCKET=
GSS_S3_REGION=
GSS_S3_ENDPOINT=
GSS_S3_RETENTION_DAYS=30

# OTLP tracing (opt-in). Endpoint must be HTTPS except loopback fixture receivers.
GSS_TRACE_EXPORT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Each TLS service has its own certificate/key; shared CA only. TLS 1.3 required.
# For manual startup use GSS_TLS_CERT_FILE/GSS_TLS_KEY_FILE in each service's env.
GSS_TLS_CA_FILE=
# Server-side public pin/SAN allowlist; mandatory for staging CP and Command Center.
# Private keys are NOT stored in this JSON; leaf pins use SHA-256 of DER certificate.
GSS_TLS_WORKLOAD_POLICY_FILE=
# Staging always enforces the PostgreSQL deny floor; local mTLS can opt in explicitly.
GSS_REQUIRE_DURABLE_WORKLOAD_REVOCATION=false
GSS_TLS_CONTROL_CERT_FILE=
GSS_TLS_CONTROL_KEY_FILE=
GSS_TLS_COMMAND_CERT_FILE=
GSS_TLS_COMMAND_KEY_FILE=
GSS_TLS_CLI_CERT_FILE=
GSS_TLS_CLI_KEY_FILE=
GSS_TLS_IDE_CERT_FILE=
GSS_TLS_IDE_KEY_FILE=
GSS_TLS_SIEM_CERT_FILE=
GSS_TLS_SIEM_KEY_FILE=
GSS_TLS_UI_CERT_FILE=
GSS_TLS_UI_KEY_FILE=
## Worker presence: Ctrl+Shift+B always enables this; staging cannot disable it.
GSS_REQUIRE_WORKER_PRESENCE=true
