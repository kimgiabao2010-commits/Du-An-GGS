{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@asq/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@asq/guardrails": [
        "packages/guardrails/src/index.ts"
      ],
      "@asq/persistence": [
        "packages/persistence/src/index.ts"
      ]
    },
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next*/**"
  ],
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "services/*/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
