{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@asq/sdk": ["packages/sdk/src/index.ts"],
      "@asq/guardrails": ["packages/guardrails/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
