{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GSS: Run local stack",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": true
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "GSS: Check before running",
      "type": "process",
      "command": "npm.cmd",
      "args": ["run", "dev:check"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "GSS: Build + typecheck + test",
      "dependsOn": ["GSS: Build", "GSS: Typecheck", "GSS: Test"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    { "label": "GSS: Build", "type": "process", "command": "npm.cmd", "args": ["run", "build"], "problemMatcher": [] },
    { "label": "GSS: Typecheck", "type": "process", "command": "npm.cmd", "args": ["run", "typecheck"], "problemMatcher": [] },
    { "label": "GSS: Test", "type": "process", "command": "npm.cmd", "args": ["run", "test"], "problemMatcher": [] }
  ]
}
