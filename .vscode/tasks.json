{
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "cmd.exe",
      "args": ["/d", "/c"]
    }
  },
  "tasks": [
    {
      "label": "🚀 Fast Boot: Chạy Toàn Bộ ASQ-Engine",
      "dependsOn": [
        "🌐 Web: Start Next.js Frontend",
        "⚙️ API: Start Standalone Command Center",
        "👷 Worker: Start CLI Sandbox Worker",
        "💻 IDE: Start Threat Hunter Agent"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🔥 Full Setup & Boot (Install + Build + Run)",
      "dependsOn": [
        "📦 Setup: Cài đặt thư viện (npm install)",
        "🔨 Setup: Biên dịch dự án (npm run build)",
        "🚀 Fast Boot: Chạy Toàn Bộ ASQ-Engine"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "📦 Setup: Cài đặt thư viện (npm install)",
      "type": "shell",
      "command": "npm install",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🔨 Setup: Biên dịch dự án (npm run build)",
      "type": "shell",
      "command": "npm run build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "🌐 Web: Start Next.js Frontend",
      "type": "shell",
      "command": "npm run dev --prefix apps/standalone",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asq-services"
      }
    },
    {
      "label": "⚙️ API: Start Standalone Command Center",
      "type": "shell",
      "command": "npm run start:standalone",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asq-services"
      }
    },
    {
      "label": "👷 Worker: Start CLI Sandbox Worker",
      "type": "shell",
      "command": "npm run start:worker",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asq-services"
      }
    },
    {
      "label": "💻 IDE: Start Threat Hunter Agent",
      "type": "shell",
      "command": "npm run start:ide",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "asq-services"
      }
    }
  ]
}
